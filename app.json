{
  "expo": {
    "name": "Heart Link",
    "slug": "HeartLink",
    "version": "1.0.44",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heartlinkdatingapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Heart Link to access your camera to take profile photos and send images in chat.",
        "NSPhotoLibraryUsageDescription": "Allow Heart Link to access your photo library to select photos for your profile and chat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.heartlinkdatingapp.app",
      "versionCode": 45,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.android.vending.BILLING",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Heart Link to access your photo library to select photos for your profile and chat.",
          "cameraPermission": "Allow Heart Link to access your camera to take profile photos and send pictures in chat."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Heart Link to use your location to find nearby matches and date spots."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#FF007F",
          "defaultChannel": "default"
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "5474961b-4bf2-4879-b71d-8ab015526254"
      }
    }
  }
}
